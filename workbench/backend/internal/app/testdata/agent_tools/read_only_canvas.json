                        "description": "可选说明",
                        "type": "string"
                      },
                      "id": {
                        "description": "稳定选项 ID",
                        "type": "string"
                      },
                      "label": {
                        "description": "选项名称",
                        "type": "string"
                      },
                      "recommended": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "label"
                    ],
                    "type": "object"
                  },
                  "maxItems": 8,
                  "type": "array"
                },
                "placeholder": {
                  "description": "输入提示",
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "title": {
                  "description": "字段显示名称",
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "single_select",
                    "multi_select",
                    "segmented",
                    "text",
                    "textarea",
                    "model_picker"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "type"
              ],
              "type": "object"
            },
            "maxItems": 6,
            "minItems": 1,
            "type": "array"
          },
          "maxRounds": {
            "description": "可选；受固定上限限制",
            "maximum": 2,
            "minimum": 1,
            "type": "integer"
