          },
          "nodeId": {
            "description": "文本或文件节点ID",
            "type": "string"
          },
          "offset": {
            "description": "字符偏移，后续用 nextOffset",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "nodeId"
        ],
        "type": "object"
      }
    },
    "type": "function"
  },
